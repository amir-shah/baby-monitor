# babymon environment file — /etc/babymon/babymon.env
#
# Loaded by every systemd unit as EnvironmentFile=. This is where secrets and
# host-specific overrides live; config/babymon.yaml is for everything else, and
# is the file you can safely commit or paste into a forum post.
#
# deploy/install.sh generates this from the template, filling in a random
# dashboard password, a random API token and a random HomeKit PIN, and then
# never touches it again — regenerating the PIN would unpair the accessory.
#
# FORMAT: systemd, not shell. KEY=value, one per line, no `export`, no command
# substitution, no variable expansion. A value is taken literally to the end of
# the line unless the WHOLE value is quoted.
#
# Any babymon config key can be overridden here: BABYMON_ + the dotted path,
# uppercased, with __ between levels. Values are parsed as YAML, so `true`,
# `12`, and `['a','b']` all arrive as the right type.
#
#     chmod 0640 /etc/babymon/babymon.env
#     chown root:babymon /etc/babymon/babymon.env

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Dashboard login. There is a camera pointed at a child's bed behind this.
BABYMON_API__AUTH__PASSWORD=@API_PASSWORD@

# Long-lived bearer token for the HomeKit bridge. It must appear in BOTH
# places: the API's accepted-token list, and the bridge's own configuration.
# Single quotes inside the list because systemd would otherwise eat double
# quotes before the YAML parser ever sees them.
BABYMON_API__AUTH__TOKENS=['@API_TOKEN@']
BABYMON_HOMEKIT__API_TOKEN=@API_TOKEN@

# HomeKit pairing code, NNN-NN-NNN. Changing it after pairing does nothing
# until you remove the accessory from the Home app and re-add it.
BABYMON_HOMEKIT__PIN=@HOMEKIT_PIN@

# Signs session cookies and the short-lived ?t= media tokens. Leave unset and
# one is generated into $data_dir/session.secret on first run; set it here if
# you want sessions to survive a wipe of the data directory.
#BABYMON_SECRET=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

BABYMON_CONFIG=/etc/babymon/babymon.yaml
BABYMON_PATHS__DATA_DIR=@DATA_DIR@
# Built dashboard assets. The API serves them at / when this exists.
BABYMON_PATHS__STATIC_DIR=@WEB_DIR@

# ---------------------------------------------------------------------------
# Camera: read from MediaMTX, do not open the device
# ---------------------------------------------------------------------------
#
# MediaMTX owns the camera (see deploy/mediamtx.yml — a CSI camera can only be
# opened once). The Python service therefore reads the cheap MJPEG secondary
# stream for motion analysis and snapshots, and merely *advertises* the H.264
# path so the HomeKit bridge knows where to pull from.
#
# If you are NOT using MediaMTX — a USB webcam, or a Pi with nothing else
# wanting the camera — delete these three lines and set camera.source in the
# YAML instead.

BABYMON_CAMERA__SOURCE=rtsp
BABYMON_CAMERA__URL=rtsp://127.0.0.1:8554/babymon-lores
BABYMON_CAMERA__RTSP_URL=rtsp://127.0.0.1:8554/babymon

# ---------------------------------------------------------------------------
# mDNS: use avahi, not the built-in responder
# ---------------------------------------------------------------------------
#
# Raspberry Pi OS runs avahi-daemon, which already owns UDP 5353. HAP-NodeJS's
# default `ciao` responder tries to bind it too, and the two then answer for
# each other's records. The symptom is an accessory that shows up in the Home
# app and then vanishes, or that will not complete pairing. Advertising through
# the system daemon removes the conflict entirely.

BABYMON_HOMEKIT__ADVERTISER=avahi

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------

# Microphone. Use the dsnoop device from deploy/asound.conf.example if both the
# detector and the HomeKit bridge need it (they do, if HomeKit audio is on).
#BABYMON_AUDIO__DEVICE=babymon_mic
#BABYMON_HOMEKIT__AUDIO__DEVICE=babymon_mic

# Environment sensor. Bookworm + Pi 5 cannot bit-bang a DHT22 reliably; an
# I2C part works on every model. See docs/HARDWARE.md.
#BABYMON_ENVIRONMENT__SENSOR=sht4x
#BABYMON_ENVIRONMENT__I2C_BUS=1

# Notifications (ntfy, Home Assistant, Slack, anything that speaks HTTP POST).
# THIS IS THE ONLY WAY DATA LEAVES THE PI, other than HKSV footage going to
# iCloud. See docs/PRIVACY.md.
#BABYMON_NOTIFICATIONS__ENABLED=true
#BABYMON_NOTIFICATIONS__WEBHOOK_URL=https://ntfy.sh/your-private-topic

# Turn the volume up on one component while debugging.
#BABYMON_LOGGING__LEVEL=DEBUG

# HAP-NodeJS's own debug channels, read by the bridge process only. The HKSV
# one prints the recording state machine: negotiated codec, fragment sizes,
# and why HomeKit closed a stream.
#DEBUG=HAP-NodeJS:HKSV
#DEBUG=HAP-NodeJS:*

# Node heap ceiling. The HKSV prebuffer is a few tens of MB; this stops a leak
# from taking the whole Pi down with it.
NODE_OPTIONS=--max-old-space-size=192
